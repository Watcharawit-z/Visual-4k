<?xml version="1.0" encoding="utf-8"?>
<!--
  UMDF 2 driver project for the Visual-4k virtual display.

  Requires the Windows Driver Kit; it supplies the WindowsUserModeDriver10.0
  platform toolset and the WDF/IddCx headers and import libraries. Without the
  WDK installed, Visual Studio will report the toolset as missing rather than
  failing in a way that points at the WDK, which is why it is called out here.

  Build:  msbuild Visual4kDisplay.vcxproj /p:Configuration=Release /p:Platform=x64
-->
<Project DefaultTargets="Build" ToolsVersion="15.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{7B4A1C90-3E5D-4A62-9F18-2C6D0A5E4B77}</ProjectGuid>
    <RootNamespace>Visual4kDisplay</RootNamespace>
    <TargetName>Visual4kDisplay</TargetName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <TargetVersion>Windows10</TargetVersion>
    <!-- Universal keeps the driver to the OneCore API surface, which is what
         lets a single binary install on Desktop, IoT and Windows on ARM. -->
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <DriverType>UMDF</DriverType>
    <!-- The WDK derives the WDF include and library directories from these,
         as Include\wdf\umdf\MAJOR.MINOR. Without them the driver toolset still
         activates and DriverType is still UMDF, but IncludePath comes out with
         no WDF entry at all and the build fails on wdf.h, which looks exactly
         like a missing WDK. The minor version is overridable so CI can pass
         whatever the installed kit actually ships. -->
    <UmdfVersionMajor>2</UmdfVersionMajor>
    <UmdfVersionMinor Condition="'$(UmdfVersionMinor)' == ''">33</UmdfVersionMinor>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- WDF include and library directories, stated explicitly.

         The WDK's own toolset is supposed to derive these, and on this project
         it does not: with PlatformToolset=WindowsUserModeDriver10.0,
         DriverType=UMDF, a correct WDKContentRoot and UmdfVersionMajor/Minor
         all set, MSBuild still resolved an IncludePath with no WDF entry, and
         every build failed on wdf.h. Rather than keep guessing at which
         property the kit wants, point at the directories directly: they are
         a documented, stable layout, and this works whether or not the WDK's
         MSBuild integration is behaving.

         Overridable so CI can pass the version the installed kit ships. -->
    <Visual4kKitRoot Condition="'$(Visual4kKitRoot)' == ''">$(WDKContentRoot)</Visual4kKitRoot>
    <Visual4kKitRoot Condition="'$(Visual4kKitRoot)' == ''">C:\Program Files (x86)\Windows Kits\10\</Visual4kKitRoot>
    <Visual4kUmdfVersion Condition="'$(Visual4kUmdfVersion)' == ''">$(UmdfVersionMajor).$(UmdfVersionMinor)</Visual4kUmdfVersion>
    <Visual4kWdfInclude>$(Visual4kKitRoot)Include\wdf\umdf\$(Visual4kUmdfVersion)</Visual4kWdfInclude>
    <Visual4kWdfLib>$(Visual4kKitRoot)Lib\wdf\umdf\x64\$(Visual4kUmdfVersion)</Visual4kWdfLib>

    <!-- IddCx is versioned the same way WDF is, and its headers refuse to
         compile without the version macros: IddCxFuncEnum.h stops with
         "IDDCX_VERSION_MAJOR is not defined" rather than picking a default.
         The kit installs them under um\iddcx\MAJOR.MINOR, so CI reads the
         version off that directory and passes it. -->
    <Visual4kIddCxMajor Condition="'$(Visual4kIddCxMajor)' == ''">1</Visual4kIddCxMajor>
    <Visual4kIddCxMinor Condition="'$(Visual4kIddCxMinor)' == ''">9</Visual4kIddCxMinor>

    <!-- The full path of the IddCx import library, not just its directory.
         Adding the directory and naming IddCx.lib still failed to link, so
         the file the kit ships is not named that; passing what was actually
         found removes the guess. -->
    <Visual4kIddCxLibFile Condition="'$(Visual4kIddCxLibFile)' == ''">IddCx.lib</Visual4kIddCxLibFile>

    <!-- The INF is signed together with the binary; without a catalog the
         package installs but the driver refuses to load with code 52. -->
    <EnableInf2cat>true</EnableInf2cat>
    <SignMode>Off</SignMode>
    <!-- Signing is done by tools/install.ps1 rather than by the build, so that
         the same binary can be test-signed locally or production-signed later
         without a rebuild. -->
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <ExceptionHandling>Sync</ExceptionHandling>
      <!-- Visual4kIddCxInclude and Visual4kIddCxLib are normally empty: the
           IddCx headers sit in the kit's um directory, which the SDK already
           contributes. They exist because a kit can place them elsewhere, and
           an empty entry costs nothing. -->
      <AdditionalIncludeDirectories>
        $(Visual4kWdfInclude);$(Visual4kIddCxInclude);%(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        _UNICODE;UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;UMDF_USING_NTSTATUS;UMDF_VERSION_MAJOR=$(UmdfVersionMajor);UMDF_VERSION_MINOR=$(UmdfVersionMinor);IDDCX_VERSION_MAJOR=$(Visual4kIddCxMajor);IDDCX_VERSION_MINOR=$(Visual4kIddCxMinor);%(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <!-- IddCx.lib is the class extension; avrt.lib is for the swap-chain
           thread's MMCSS registration. -->
      <AdditionalLibraryDirectories>
        $(Visual4kWdfLib);$(Visual4kIddCxLib);%(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        WdfDriverStubUm.lib;$(Visual4kIddCxLibFile);d3d11.lib;dxgi.lib;avrt.lib;%(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
    <Inf>
      <TimeStampServer>http://timestamp.digicert.com</TimeStampServer>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="Driver.cpp" />
    <ClCompile Include="Edid.cpp" />
    <ClCompile Include="SwapChainProcessor.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="Driver.h" />
    <ClInclude Include="Edid.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="Visual4kDisplay.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
