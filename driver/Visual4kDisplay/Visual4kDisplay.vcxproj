<?xml version="1.0" encoding="utf-8"?>
<!--
  UMDF 2 driver project for the Visual-4k virtual display.

  Requires the Windows Driver Kit; it supplies the WindowsUserModeDriver10.0
  platform toolset and the WDF/IddCx headers and import libraries. Without the
  WDK installed, Visual Studio will report the toolset as missing rather than
  failing in a way that points at the WDK, which is why it is called out here.

  Build:  msbuild Visual4kDisplay.vcxproj /p:Configuration=Release /p:Platform=x64
-->
<Project DefaultTargets="Build" ToolsVersion="15.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{7B4A1C90-3E5D-4A62-9F18-2C6D0A5E4B77}</ProjectGuid>
    <RootNamespace>Visual4kDisplay</RootNamespace>
    <TargetName>Visual4kDisplay</TargetName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <TargetVersion>Windows10</TargetVersion>
    <!-- Universal keeps the driver to the OneCore API surface, which is what
         lets a single binary install on Desktop, IoT and Windows on ARM. -->
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <DriverType>UMDF</DriverType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- The INF is signed together with the binary; without a catalog the
         package installs but the driver refuses to load with code 52. -->
    <EnableInf2cat>true</EnableInf2cat>
    <SignMode>Off</SignMode>
    <!-- Signing is done by tools/install.ps1 rather than by the build, so that
         the same binary can be test-signed locally or production-signed later
         without a rebuild. -->
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <ExceptionHandling>Sync</ExceptionHandling>
      <PreprocessorDefinitions>
        _UNICODE;UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <!-- IddCx.lib is the class extension; avrt.lib is for the swap-chain
           thread's MMCSS registration. -->
      <AdditionalDependencies>
        IddCx.lib;d3d11.lib;dxgi.lib;avrt.lib;%(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
    <Inf>
      <TimeStampServer>http://timestamp.digicert.com</TimeStampServer>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="Driver.cpp" />
    <ClCompile Include="Edid.cpp" />
    <ClCompile Include="SwapChainProcessor.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="Driver.h" />
    <ClInclude Include="Edid.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="Visual4kDisplay.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
